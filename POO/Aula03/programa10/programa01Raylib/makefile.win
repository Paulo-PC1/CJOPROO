# Project: programa01Raylib
# Makefile created by Red Panda C++ 3.4.3279

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-Wl,--stack,12582912"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) "-g3" "-fno-ms-extensions" "-pipe" "-Wall" "-Werror=return-type" "-Werror=vla" "-D_DEBUG"
CFLAGS   = $(INCS) "-g3" "-fno-ms-extensions" "-pipe" "-Wall" "-Werror=implicit-int" "-Werror=return-type" "-Werror=vla" "-D_DEBUG"
NASM_FLAGS   =  "-f" "elf64" "-g"
WINDRESFLAGS = 
RES      = programa01Raylib_private.res
OBJ      = main.o $(RES)
BIN      = programa01Raylib.exe
LINKOBJ  = "main.o" "programa01Raylib_private.res"
CLEANOBJ = "main.o" "programa01Raylib_private.res" "programa01Raylib.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

programa01Raylib.exe: $(OBJ)

	$(CXX) $(LINKOBJ) -o "programa01Raylib.exe" $(LIBS)

main.o: main.cpp
	$(CXX) -c "main.cpp" -o "main.o" $(CXXFLAGS) 

programa01Raylib_private.res: programa01Raylib_private.rc 
	$(WINDRES) -i "programa01Raylib_private.rc" --input-format=rc -o "programa01Raylib_private.res" -O coff $(WINDRESFLAGS) 

